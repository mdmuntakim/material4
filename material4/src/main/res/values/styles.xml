<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Aurora / depth / shape / motion defaults for the light theme. -->
    <style name="ThemeOverlay.Material4" parent="">
        <item name="m4AuroraStart">@color/m4_aurora_start</item>
