    <style name="ThemeOverlay.Material4.Material3Baseline" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="m4Superellipse">false</item>
        <item name="m4MorphOnPress">false</item>
        <item name="m4HapticsEnabled">false</item>
        <item name="m4HighContrast">false</item>
        <item name="m4ComparisonMode">true</item>
    </style>

    <!-- Widget styles. Each one only overrides public Material 3 style items. -->
    <style name="Widget.Material4.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material4.Medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">?attr/m4LabelTextAppearance</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/m4_button_stroke</item>
    </style>

    <style name="Widget.Material4.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material4.Medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">?attr/m4LabelTextAppearance</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Material4.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material4.Medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">?attr/m4LabelTextAppearance</item>
    </style>

    <style name="Widget.Material4.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>

    <style name="Widget.Material4.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="thumbTint">@color/m4_switch_thumb</item>
        <item name="trackTint">@color/m4_switch_track</item>
    </style>

    <style name="Widget.Material4.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="buttonTint">@color/m4_checkbox_tint</item>
    </style>

    <style name="Widget.Material4.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="buttonTint">@color/m4_checkbox_tint</item>
    </style>

    <style name="Widget.Material4.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material4.Medium</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipMinTouchTargetSize">48dp</item>
        <item name="android:textAppearance">?attr/m4LabelTextAppearance</item>
    </style>

    <style name="Widget.Material4.ChipGroup" parent="Widget.Material3.ChipGroup">
        <item name="chipSpacingHorizontal">8dp</item>
        <item name="chipSpacingVertical">8dp</item>
        <item name="singleLine">false</item>
    </style>

    <style name="Widget.Material4.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextAppearance">?attr/m4BodyTextAppearance</item>
    </style>

    <style name="Widget.Material4.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabRippleColor">?attr/colorControlHighlight</item>
        <item name="tabTextAppearance">?attr/m4LabelTextAppearance</item>
    </style>

    <style name="Widget.Material4.Slider" parent="Widget.Material3.Slider">
        <item name="thumbRadius">10dp</item>
        <item name="trackHeight">6dp</item>
        <item name="haloRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Material4.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material4.Large</item>
        <item name="elevation">6dp</item>
    </style>

    <style name="Widget.Material4.ExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material4.Large</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.Material4.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerThickness">1dp</item>
        <item name="dividerColor">?attr/colorOutlineVariant</item>
    </style>

    <style name="Widget.Material4.NavigationBar" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.Material4.NavigationBar.ActiveIndicator</item>
        <item name="elevation">3dp</item>
    </style>

    <style name="Widget.Material4.NavigationBar.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="shapeAppearance">@style/ShapeAppearance.Material4.Medium</item>
        <item name="android:color">?attr/colorSecondaryContainer</item>
    </style>

    <style name="Widget.Material4.NavigationRail" parent="Widget.Material3.NavigationRailView">
        <item name="itemActiveIndicatorStyle">@style/Widget.Material4.NavigationRail.ActiveIndicator</item>
    </style>

    <style name="Widget.Material4.NavigationRail.ActiveIndicator" parent="Widget.Material3.NavigationRailView.ActiveIndicator">
        <item name="shapeAppearance">@style/ShapeAppearance.Material4.Medium</item>
        <item name="android:color">?attr/colorSecondaryContainer</item>
    </style>

    <style name="Widget.Material4.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">?attr/m4TitleTextAppearance</item>
        <item name="subtitleTextAppearance">?attr/m4BodyTextAppearance</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
    </style>

    <style name="Widget.Material4.SearchBar" parent="Widget.Material3.SearchBar">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material4.Full</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.Material4.SearchView" parent="Widget.Material3.SearchView" />

    <style name="Widget.Material4.Badge" parent="Widget.Material3.Badge">
        <item name="backgroundColor">?attr/colorTertiary</item>
        <item name="badgeTextColor">?attr/colorOnTertiary</item>
    </style>

    <style name="Widget.Material4.CircularProgress" parent="Widget.Material3.CircularProgressIndicator">
        <item name="trackThickness">5dp</item>
        <item name="indicatorSize">48dp</item>
        <item name="trackCornerRadius">3dp</item>
    </style>

    <style name="Widget.Material4.LinearProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">6dp</item>
        <item name="trackCornerRadius">3dp</item>
    </style>

    <style name="Widget.Material4.BottomAppBar" parent="Widget.Material3.BottomAppBar">
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
    </style>

    <style name="Widget.Material4.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material4.Medium</item>
        <item name="backgroundTint">?attr/colorInverseSurface</item>
        <item name="android:layout_margin">12dp</item>
    </style>

    <style name="Widget.Material4.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material4.ExtraLarge</item>
    </style>
</resources>
