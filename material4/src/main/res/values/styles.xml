        <item name="materialButtonStyle">@style/Widget.Material4.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Material4.Button.Outlined</item>
        <item name="materialButtonTonalStyle">@style/Widget.Material4.Button.Tonal</item>
        <item name="materialCardViewStyle">@style/Widget.Material4.Card</item>
        <item name="materialSwitchStyle">@style/Widget.Material4.Switch</item>
        <item name="checkboxStyle">@style/Widget.Material4.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.Material4.RadioButton</item>
        <item name="chipStyle">@style/Widget.Material4.Chip</item>
        <item name="chipStandaloneStyle">@style/Widget.Material4.Chip</item>
        <item name="chipGroupStyle">@style/Widget.Material4.ChipGroup</item>
        <item name="textInputStyle">@style/Widget.Material4.TextInput</item>
        <item name="textInputOutlinedStyle">@style/Widget.Material4.TextInput</item>
        <item name="tabStyle">@style/Widget.Material4.TabLayout</item>
        <item name="sliderStyle">@style/Widget.Material4.Slider</item>
        <item name="floatingActionButtonStyle">@style/Widget.Material4.Fab</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.Material4.ExtendedFab</item>
        <item name="materialDividerStyle">@style/Widget.Material4.Divider</item>
        <item name="bottomNavigationStyle">@style/Widget.Material4.NavigationBar</item>
        <item name="navigationRailStyle">@style/Widget.Material4.NavigationRail</item>
        <item name="toolbarStyle">@style/Widget.Material4.Toolbar</item>
        <item name="materialSearchBarStyle">@style/Widget.Material4.SearchBar</item>
        <item name="materialSearchViewStyle">@style/Widget.Material4.SearchView</item>
        <item name="badgeStyle">@style/Widget.Material4.Badge</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.Material4.CircularProgress</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.Material4.LinearProgress</item>
        <item name="bottomAppBarStyle">@style/Widget.Material4.BottomAppBar</item>
        <item name="snackbarStyle">@style/Widget.Material4.Snackbar</item>
        <item name="bottomSheetStyle">@style/Widget.Material4.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.Material4.HighContrast" parent="ThemeOverlay.Material4">
        <item name="m4HighContrast">true</item>
        <item name="m4ComparisonMode">false</item>
        <item name="m4Superellipse">false</item>
        <item name="m4MorphOnPress">false</item>
        <item name="m4AuroraStart">@color/m4_hc_primary</item>
        <item name="m4AuroraMid">@color/m4_hc_accent</item>
        <item name="m4AuroraEnd">@color/m4_hc_primary</item>
        <item name="m4GlassSurface">@color/m4_hc_surface</item>
        <item name="m4GlassBorderStart">@color/m4_hc_outline</item>
        <item name="m4GlassBorderEnd">@color/m4_hc_outline</item>
        <item name="m4InnerGlow">@android:color/transparent</item>
        <item name="colorPrimary">@color/m4_hc_primary</item>
        <item name="colorOnPrimary">@color/m4_hc_on_primary</item>
        <item name="colorPrimaryContainer">@color/m4_hc_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m4_hc_on_primary_container</item>
        <item name="colorSecondary">@color/m4_hc_accent</item>
        <item name="colorOnSecondary">@color/m4_hc_on_accent</item>
        <item name="colorSurface">@color/m4_hc_surface</item>
        <item name="colorOnSurface">@color/m4_hc_on_surface</item>
        <item name="colorSurfaceVariant">@color/m4_hc_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m4_hc_on_surface</item>
        <item name="colorOutline">@color/m4_hc_outline</item>
        <item name="colorOutlineVariant">@color/m4_hc_outline</item>
    </style>

    <style name="Theme.Material4" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material4</item>
        <item name="m4AuroraStart">@color/m4_aurora_start</item>
        <item name="m4AuroraMid">@color/m4_aurora_mid</item>
        <item name="m4AuroraEnd">@color/m4_aurora_end</item>
